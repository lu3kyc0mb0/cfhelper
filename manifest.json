{
  "manifest_version": 3,
  "name": "Codeforces Helper",
  "version": "1.0.0",
  "description": "Native archive filters, bookmarks, practice history, themes and exports for Codeforces.",
  "browser_specific_settings": {"gecko": {"id": "cfhelper@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}},
  "permissions": ["storage"],
  "host_permissions": ["https://codeforces.com/*"],
  "background": {"scripts": ["core.js", "background.js"]},
  "icons": {"48": "cfhelper.png", "96": "cfhelper.png"},
  "options_ui": {"page": "options.html", "open_in_tab": false},
  "content_scripts": [{"matches": ["https://codeforces.com/problemset", "https://codeforces.com/problemset?*", "https://codeforces.com/problemset/", "https://codeforces.com/problemset/?*", "https://codeforces.com/problemset/page/*"], "js": ["core.js", "i18n.js", "ui.js", "settings.js", "content.js"], "css": ["content.css"]}],
  "web_accessible_resources": [{"resources": ["cfhelper.png", "cfhelper.jpg"], "matches": ["https://codeforces.com/*"]}]
}
